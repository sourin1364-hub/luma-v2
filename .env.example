VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GLOBAL_PRICE_INCREASE_PERCENT=0

# Configure these as Supabase Edge Function secrets; never add a VITE_ prefix.
# Required custom Edge Function secrets:
# APP_ALLOWED_ORIGIN=https://your-domain.example
# APP_BASE_URL=https://your-domain.example/luma-v2/
# ZARINPAL_MERCHANT_ID=your_merchant_id
# ZARINPAL_SANDBOX=true
# GLOBAL_PRICE_INCREASE_PERCENT=0
# MELIPAYAMAK_API_KEY=your_melipayamak_api_key
# MELIPAYAMAK_PATTERN_CODE=your_numeric_pattern_code
# MELIPAYAMAK_SENDER=your_service_sender_number
# OPENAI_API_KEY=your_server_side_openai_key
# OPENAI_MODEL=gpt-4o-mini
#
# Supabase Edge Functions also require the project URL, anon key, and service-role
# key in their server environment. Use the Supabase CLI/dashboard secret manager.
